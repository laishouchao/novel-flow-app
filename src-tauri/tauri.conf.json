{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "NovelFlow",
    "version": "0.4.3"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": [
          "**"
        ]
      },
      "http": {
        "all": true,
        "request": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.novelflow.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/512x512.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "resources": [],
      "copyright": "",
      "category": "Utility",
      "shortDescription": "AI Novel Writing Assistant",
      "longDescription": "AI-assisted long novel writing client with brainstorming, outline planning, AI writing, anti-AI flavor review, and style engines.",
      "deb": {
        "depends": [],
        "files": {}
      },
      "rpm": {
        "depends": [],
        "release": "1"
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "NovelFlow - AI写作工作台",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ]
  }
}
